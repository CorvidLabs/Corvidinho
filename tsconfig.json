{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ],
    "rootDir": ".",
    "baseUrl": ".",
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "plugins/**/*.ts",
    "tests/**/*.ts"
  ]
}
